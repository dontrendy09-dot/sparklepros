# ─────────────────────────────────────────────────────────────
# Sparkle Pros website — environment variables
# Copy to `.env.local` for local development. On Vercel, add these in
# Project → Settings → Environment Variables. Never commit real values.
# ─────────────────────────────────────────────────────────────

# Public URL of the live site. Used for canonical URLs, the sitemap,
# robots.txt and Open Graph tags. No trailing slash.
NEXT_PUBLIC_SITE_URL=https://sparklepros.in

# ── SMTP (server-only — do NOT prefix with NEXT_PUBLIC_) ─────
# Gmail / Google Workspace: smtp.gmail.com, port 465, SMTP_SECURE=true,
# SMTP_PASS = a 16-character App Password (requires 2-Step Verification).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
# true for port 465 (implicit TLS); false for 587 (STARTTLS is upgraded automatically)
SMTP_SECURE=true
SMTP_USER=sparkleprosbooking@gmail.com
SMTP_PASS=replace-with-app-password

# Inbox that receives quote requests. Comma-separate multiple addresses.
QUOTE_TO_EMAIL=sparkleprosbooking@gmail.com

# "From" header for notification emails. Must be an address your SMTP
# account is allowed to send as (for Gmail: the same as SMTP_USER).
QUOTE_FROM_EMAIL="Sparkle Pros Website <sparkleprosbooking@gmail.com>"
